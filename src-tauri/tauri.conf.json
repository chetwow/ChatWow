{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatWow",
  "version": "0.3.0",
  "identifier": "io.github.chetwow.chatwow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatWow",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 320,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0b0b0f",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}