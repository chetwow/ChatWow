{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatWow",
  "version": "1.2.0",
  "identifier": "io.github.chetwow.chatwow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatWow",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 320,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0b0b0f",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQkE0MEFFNDM5Q0M0NkYKUldSdnhKeERya0M2LzJ4ZXZlNmZLeVR5SnFBWUVwWlV2S3ZpbHV4cXB0UzdOVFg0dWRUL0s1T3UK",
      "endpoints": [
        "https://github.com/chetwow/ChatWow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
